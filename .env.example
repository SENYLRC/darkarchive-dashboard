# Dark Archive — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_NAME=darkarchive
DB_USER=darkarchive_user
DB_PASS=your_strong_password_here
RDS_CERT=/etc/mysql-certs/global-bundle.pem

# File storage
UPLOAD_DIR=/var/www/darkarchive/uploads/

# Google reCAPTCHA Enterprise
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_PROJECT=your_gcp_project_id_here
# Optional — minimum risk score to accept (default 0.5)
#RECAPTCHA_MIN_SCORE=0.5
# Path to the service-account key. Set this rather than relying on a
# GOOGLE_APPLICATION_CREDENTIALS environment variable: env vars do not reach
# PHP-FPM pools and are absent under cron unless set inline. The file must be
# readable by the web server user (root:www-data, mode 640). It lives in the
# app root, above the DocumentRoot, so it is never web-served.
# Leave blank to fall back to Application Default Credentials.
GOOGLE_CREDENTIALS_FILE=/var/www/darkarchive/service-account-key.json

# S3 (used only by report_s3_reconciliation.php — the real archived assets
# live here; darkarchive itself only stores the descriptive METS XML).
# Credentials are explicit, not the ambient AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# environment-variable discovery the AWS SDK falls back to: load_env() only
# populates $_ENV, not the real process environment, so the SDK's default
# provider chain would not see these even though $_ENV has them.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Email
MAIL_FROM=noreply@yourdomain.org
MAIL_FROM_NAME=Dark Archive
MAIL_NOC=noc@yourdomain.org
SITE_URL=https://your-domain.org
SITE_NAME=Dark Archive
